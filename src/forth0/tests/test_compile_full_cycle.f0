# test_compile_full_cycle.f0 — system test for in-space token compilation
#
# Writes 5 HALT tokens at TESTG+200, then calls SETUP_INSPACE
# which compiles them into cells via BRANCH/DO/END cycle.
# After HALT, the cell chain is verified by the tdd script.
#
# This is a level-3 (system) test: full cycle from token writing
# through in-space compilation to chain verification.

# === Step 1: Write 5 HALT tokens at TESTG+200 ===
# Each token is 24 bits, so tokens are at offsets 0, 24, 48, 72, 96
# from the base address TESTG+200.
set24 (TESTG + 200) HALT
set24 (TESTG + 224) HALT
set24 (TESTG + 248) HALT
set24 (TESTG + 272) HALT
set24 (TESTG + 296) HALT

# === Step 2: Set VAR_PREV_NEXT_FLD to HEAD_CELL + 32 ===
# This points to the head cell's next_ptr field, so the first
# compiled cell gets linked into the chain.
set24 VAR_PREV_NEXT_FLD (HEAD_CELL + 32)

# === Step 3: Set VAR_SRC_ADDR and VAR_SRC_END ===
# IMPORTANT: must come AFTER all set24 directives (they use LITN
# internally and would clobber VAR_SRC_ADDR/VAR_SRC_END).
# VAR_SRC_END = TESTG + 200 + 5 * 24 = TESTG + 320.
set24 VAR_SRC_ADDR (TESTG + 200)
set24 VAR_SRC_END (TESTG + 320)

# === Step 4: Call SETUP_INSPACE ===
# This configures in-space mode (reads tokens from memory instead
# of stdin), sets in_req=1, and chain-loads the BRANCH page.
# BRANCH dispatches to DO for each token or END when source is
# exhausted. DO compiles one token per invocation, linking cells
# into the chain. When END is reached, it sets halt=1.
SETUP_INSPACE

# (not reached — SETUP_INSPACE chain-loads through BRANCH/DO/END
#  and does not return control to this sequence)
