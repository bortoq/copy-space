# C3 RV32M fast-path scaffold (14.20.3A)
# stop reason=1, pc=0x00000024, instr=mul surrogate 0x02000033, steps=8
# payload words:
#   w0 mul(x,0)           = 0x00000000
#   w1 mul(x,1)           = 0x12345678
#   w2 div(x,1)           = 0x89ABCDEF
#   w3 div(x,0)           = 0xFFFFFFFF
#   w4 rem(x,0)           = 0x89ABCDEF
#   w5 div(INT_MIN,-1)    = 0x80000000
#   w6 rem(INT_MIN,-1)    = 0x00000000
#   w7 mul(-1,2)          = 0xFFFFFFFE

setbyte TESTG 0x01
setbyte (TESTG + 1*8) 0x00
setbyte (TESTG + 2*8) 0x00
setbyte (TESTG + 3*8) 0x00
setbyte (TESTG + 4*8) 0x24

setbyte (TESTG + 5*8) 0x02
setbyte (TESTG + 6*8) 0x00
setbyte (TESTG + 7*8) 0x00
setbyte (TESTG + 8*8) 0x33

setbyte (TESTG + 9*8)  0x00
setbyte (TESTG + 10*8) 0x00
setbyte (TESTG + 11*8) 0x00
setbyte (TESTG + 12*8) 0x00

setbyte (TESTG + 13*8) 0x00
setbyte (TESTG + 14*8) 0x00
setbyte (TESTG + 15*8) 0x00
setbyte (TESTG + 16*8) 0x08

setbyte (TESTG + 17*8) 0x00
setbyte (TESTG + 18*8) 0x00
setbyte (TESTG + 19*8) 0x00

# w0
setbyte (TESTG + 20*8) 0x00
setbyte (TESTG + 21*8) 0x00
setbyte (TESTG + 22*8) 0x00
setbyte (TESTG + 23*8) 0x00
# w1
setbyte (TESTG + 24*8) 0x12
setbyte (TESTG + 25*8) 0x34
setbyte (TESTG + 26*8) 0x56
setbyte (TESTG + 27*8) 0x78
# w2
setbyte (TESTG + 28*8) 0x89
setbyte (TESTG + 29*8) 0xAB
setbyte (TESTG + 30*8) 0xCD
setbyte (TESTG + 31*8) 0xEF
# w3
setbyte (TESTG + 32*8) 0xFF
setbyte (TESTG + 33*8) 0xFF
setbyte (TESTG + 34*8) 0xFF
setbyte (TESTG + 35*8) 0xFF
# w4
setbyte (TESTG + 36*8) 0x89
setbyte (TESTG + 37*8) 0xAB
setbyte (TESTG + 38*8) 0xCD
setbyte (TESTG + 39*8) 0xEF
# w5
setbyte (TESTG + 40*8) 0x80
setbyte (TESTG + 41*8) 0x00
setbyte (TESTG + 42*8) 0x00
setbyte (TESTG + 43*8) 0x00
# w6
setbyte (TESTG + 44*8) 0x00
setbyte (TESTG + 45*8) 0x00
setbyte (TESTG + 46*8) 0x00
setbyte (TESTG + 47*8) 0x00
# w7
setbyte (TESTG + 48*8) 0xFF
setbyte (TESTG + 49*8) 0xFF
setbyte (TESTG + 50*8) 0xFF
setbyte (TESTG + 51*8) 0xFE

HALT
