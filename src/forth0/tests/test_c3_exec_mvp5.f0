# C3 S4 MVP-5 exec scaffold smoke (addi/add/sw/beq/jal)
#
# This is an execution-contract scaffold for the MVP-5 instruction slice.
# It encodes expected architectural effects into TESTG.
#
# Stop dump [0..19] (same as C3 contract):
#   reason=1 (guest HALT)
#   guest_pc=0x00000014
#   instr=0x0000006f (jal)
#   fault_addr=0
#   guest_steps=5
#   reserved=0
#
# Exec effects [20..36]:
#   x1=0x00000005  (addi)
#   x2=0x00000008  (add)
#   mem_word0=0x00000008 (sw)
#   beq_taken=0x01
#   jal_link=0x00000014

# stop dump
setbyte TESTG 0x01
setbyte (TESTG + 1*8) 0x00
setbyte (TESTG + 2*8) 0x00
setbyte (TESTG + 3*8) 0x00
setbyte (TESTG + 4*8) 0x14

setbyte (TESTG + 5*8) 0x00
setbyte (TESTG + 6*8) 0x00
setbyte (TESTG + 7*8) 0x00
setbyte (TESTG + 8*8) 0x6F

setbyte (TESTG + 9*8)  0x00
setbyte (TESTG + 10*8) 0x00
setbyte (TESTG + 11*8) 0x00
setbyte (TESTG + 12*8) 0x00

setbyte (TESTG + 13*8) 0x00
setbyte (TESTG + 14*8) 0x00
setbyte (TESTG + 15*8) 0x00
setbyte (TESTG + 16*8) 0x05

setbyte (TESTG + 17*8) 0x00
setbyte (TESTG + 18*8) 0x00
setbyte (TESTG + 19*8) 0x00

# x1 = 5
setbyte (TESTG + 20*8) 0x00
setbyte (TESTG + 21*8) 0x00
setbyte (TESTG + 22*8) 0x00
setbyte (TESTG + 23*8) 0x05

# x2 = 8
setbyte (TESTG + 24*8) 0x00
setbyte (TESTG + 25*8) 0x00
setbyte (TESTG + 26*8) 0x00
setbyte (TESTG + 27*8) 0x08

# mem[0] = 8 (sw effect)
setbyte (TESTG + 28*8) 0x00
setbyte (TESTG + 29*8) 0x00
setbyte (TESTG + 30*8) 0x00
setbyte (TESTG + 31*8) 0x08

# beq taken flag
setbyte (TESTG + 32*8) 0x01

# jal link
setbyte (TESTG + 33*8) 0x00
setbyte (TESTG + 34*8) 0x00
setbyte (TESTG + 35*8) 0x00
setbyte (TESTG + 36*8) 0x14

HALT
