\ Minimal in-memory filesystem for BusyBox on Forth0 / Copy-Space
\ Very simple: fixed number of files, flat structure, in RAM

include "src/forth0/lib/std.f0"

\ === FS structures ===

32 constant MAX_FILES
64 constant MAX_NAME
256 constant MAX_FILE_SIZE

\ File table: name (64) + size (4) + data (256) per file
create file-table  MAX_FILES  (64 + 4 + 256) * allot

\ === Helpers ===

: file-addr ( idx -- addr )
    (64 + 4 + 256) * file-table +
;

: file-name ( idx -- c-addr )
    file-addr
;

: file-size ( idx -- addr )
    file-addr 64 +
;

: file-data ( idx -- addr )
    file-addr 68 +
;

\ === FS operations ===

: fs-init ( -- )
    file-table MAX_FILES (64 + 4 + 256) * 0 fill
;

: fs-find ( name len -- idx | -1 )
    MAX_FILES 0 do
        i file-name over compare 0= if
            2drop i unloop exit
        then
    loop
    2drop -1
;

: touch ( name len -- )
    2dup fs-find -1 <> if 2drop exit then   \ already exists

    MAX_FILES 0 do
        i file-size @ 0= if
            i file-name swap move
            0 i file-size !
            unloop exit
        then
    loop
    ." FS full" cr
;

: write ( data len name len -- )
    2dup fs-find dup -1 = if
        2drop 2drop ." No such file" cr exit
    then
    ( data len idx )
    dup >r
    file-data swap move
    r> file-size !
;

: cat-file ( name len -- )
    fs-find dup -1 = if drop ." No such file" cr exit then
    dup file-size @ swap file-data swap
    0 do dup i + c@ emit loop drop cr
;

: ls-fs ( -- )
    MAX_FILES 0 do
        i file-size @ 0<> if
            i file-name 64 type space
        then
    loop
    cr
;

\ === Demo ===

: fs-demo ( -- )
    fs-init
    s" hello.txt" touch
    s" Hello from Copy-Space FS!" 24 s" hello.txt" write
    s" hello.txt" cat-file
    ls-fs
;