\ Minimal BusyBox-like environment for Copy-Space (Forth0)
\ Implements a few core utilities + simple shell

include "src/forth0/lib/std.f0"

\ === Basic commands ===

: echo ( ... -- )
    begin dup while emit space repeat drop cr
;

: cat ( addr len -- )
    \ Simplified: just emit bytes from region
    0 do dup i + c@ emit loop drop cr
;

: ls ( -- )
    ." bin/ etc/ home/ " cr
;

: pwd ( -- )
    ." / " cr
;

\ === Simple REPL ===

: prompt ( -- )
    ." busybox> " 
;

: process-cmd ( c-addr -- )
    dup s" echo" compare 0= if echo exit then
    dup s" ls"   compare 0= if ls   exit then
    dup s" pwd"  compare 0= if pwd  exit then
    ." Unknown command: " type cr
;

: busybox-shell ( -- )
    begin
        prompt
        \ In real system would read input here
        \ For demo we just show the structure
    again
;

\ Entry point
: main ( -- )
    ." BusyBox v1.0 (Copy-Space / Forth0)" cr
    ls
    busybox-shell
;