; load_add8_lut.copy
; Размещение полной LUT сложения байтов по модулю 256.

ADD8_IMAGE_BASE 32768
ADD8_IMAGE_BITS 3337

ARG_PACKED 65536
ARG_BITS 65552
SUM_BITS 65568
SUM_PACKED 65576
CONST8_BITS 65584

LUT_ADD8_BASE 524288
PROOF_INDEX 0x0201
PROOF_ENTRY_BITS 524288
LOAD_ADD8_LUT_BITS LUT_ADD8_BASE-ADD8_IMAGE_BASE+PROOF_ENTRY_BITS

LUT_SLOT_SRC_PATCH 2532
OUT_SLOT_N_PATCH 142
HALT_SLOT_N_PATCH 3266
IN_STATUS_FULL_BIT 123
HALT_LAYER_BASE 163840
