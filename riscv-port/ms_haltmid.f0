macro COPY_32(dst, src)
  copybits 32 dst src
endmacro

COPY_32((TMP0 + 0*32), H_BASE + 0*32)
COPY_32((TMP0 + 1*32), H_BASE + 1*32)
COPY_32((TMP0 + 2*32), H_BASE + 2*32)
