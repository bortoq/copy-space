; add8.copy
; Сложение байтов через полную LUT; перенос за пределы байта отбрасывается.

include load_add8_lut.copy

0 0 0
16 ARG_PACKED ARG_PACKED
0 SUM_PACKED 0

BYTE_TO_BITS_SRC ARG_PACKED
BYTE_TO_BITS_DST ARG_BITS
include byte_to_bits.copy

BYTE_TO_BITS_SRC ARG_PACKED+8
BYTE_TO_BITS_DST ARG_BITS+8
include byte_to_bits.copy

1 LUT_SLOT_SRC_PATCH+3 ARG_BITS+0
1 LUT_SLOT_SRC_PATCH+4 ARG_BITS+1
1 LUT_SLOT_SRC_PATCH+5 ARG_BITS+2
1 LUT_SLOT_SRC_PATCH+6 ARG_BITS+3
1 LUT_SLOT_SRC_PATCH+7 ARG_BITS+4
1 LUT_SLOT_SRC_PATCH+8 ARG_BITS+5
1 LUT_SLOT_SRC_PATCH+9 ARG_BITS+6
1 LUT_SLOT_SRC_PATCH+10 ARG_BITS+7
1 LUT_SLOT_SRC_PATCH+11 ARG_BITS+8
1 LUT_SLOT_SRC_PATCH+12 ARG_BITS+9
1 LUT_SLOT_SRC_PATCH+13 ARG_BITS+10
1 LUT_SLOT_SRC_PATCH+14 ARG_BITS+11
1 LUT_SLOT_SRC_PATCH+15 ARG_BITS+12
1 LUT_SLOT_SRC_PATCH+16 ARG_BITS+13
1 LUT_SLOT_SRC_PATCH+17 ARG_BITS+14
1 LUT_SLOT_SRC_PATCH+18 ARG_BITS+15

8 SUM_BITS LUT_ADD8_BASE

BITS_TO_BYTE_SRC SUM_BITS
BITS_TO_BYTE_DST SUM_PACKED
include bits_to_byte.copy

8 OUT_SLOT_N_PATCH CONST8_BITS

; Полное чтение двух байтов даёт статус 32, его бит 5 равен единице.
; Включаем загрузку слоя вывода и остановки длиной 512 бит.
1 HALT_SLOT_N_PATCH+9 IN_STATUS_FULL_BIT
0 PROCESSOR_START HALT_LAYER_BASE
