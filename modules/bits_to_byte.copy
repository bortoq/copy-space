; bits_to_byte.copy
; Требует:
;   BITS_TO_BYTE_SRC
;   BITS_TO_BYTE_DST

1 BITS_TO_BYTE_DST+7 BITS_TO_BYTE_SRC+0
1 BITS_TO_BYTE_DST+6 BITS_TO_BYTE_SRC+1
1 BITS_TO_BYTE_DST+5 BITS_TO_BYTE_SRC+2
1 BITS_TO_BYTE_DST+4 BITS_TO_BYTE_SRC+3
1 BITS_TO_BYTE_DST+3 BITS_TO_BYTE_SRC+4
1 BITS_TO_BYTE_DST+2 BITS_TO_BYTE_SRC+5
1 BITS_TO_BYTE_DST+1 BITS_TO_BYTE_SRC+6
1 BITS_TO_BYTE_DST+0 BITS_TO_BYTE_SRC+7
