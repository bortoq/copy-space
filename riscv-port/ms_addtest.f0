include "fix_bitwise.f0"

const TMP_CARRY (TESTG + 4800)
const SCR_BYTE (TESTG + 4808)

const H_BASE  TESTG
const W_BASE  (TESTG + 256)
const K_BASE  (TESTG + 2304)
const TMP0    (TESTG + 4352)
const TMP1    (TESTG + 4384)
const TMP2    (TESTG + 4416)
const TMP3    (TESTG + 4448)
const TMP4    (TESTG + 4480)
const TMP5    (TESTG + 4512)
const TMP6    (TESTG + 4544)
const TMP7    (TESTG + 4576)
const SCR0    (TESTG + 4608)
const SCR1    (TESTG + 4640)
const SCR2    (TESTG + 4672)
const SCR3    (TESTG + 4704)

setbyte (K_BASE + 0*32 + 0) 0x42
setbyte (K_BASE + 0*32 + 8) 0x8a
setbyte (K_BASE + 0*32 + 16) 0x2f
setbyte (K_BASE + 0*32 + 24) 0x98

setbyte (H_BASE + 0*32 + 0) 0x6a
setbyte (H_BASE + 0*32 + 8) 0x09
setbyte (H_BASE + 0*32 + 16) 0xe6
setbyte (H_BASE + 0*32 + 24) 0x67

setbyte (W_BASE + 0*32 + 0) 0x61
setbyte (W_BASE + 0*32 + 8) 0x62
setbyte (W_BASE + 0*32 + 16) 0x63
setbyte (W_BASE + 0*32 + 24) 0x80

macro COPY_32(dst, src)
  copybits 32 dst src
endmacro

ROTR_32(17, TMP4, (W_BASE + 14*32))
ROTR_32(19, TMP5, (W_BASE + 14*32))
BITWISE_XOR_32(TMP4, TMP4, TMP5)
SHR_32(10, TMP5, (W_BASE + 14*32))
BITWISE_XOR_32(TMP4, TMP4, TMP5)
ROTR_32(7, TMP6, (W_BASE + 1*32))
ROTR_32(18, TMP7, (W_BASE + 1*32))
BITWISE_XOR_32(TMP6, TMP6, TMP7)
SHR_32(3, TMP7, (W_BASE + 1*32))
BITWISE_XOR_32(TMP6, TMP6, TMP7)
ADD_32(TMP4, TMP4, (W_BASE + 9*32))

ROTR_32(17, TMP4, (W_BASE + 15*32))
ROTR_32(19, TMP5, (W_BASE + 15*32))
BITWISE_XOR_32(TMP4, TMP4, TMP5)
SHR_32(10, TMP5, (W_BASE + 15*32))
BITWISE_XOR_32(TMP4, TMP4, TMP5)
ROTR_32(7, TMP6, (W_BASE + 2*32))
ROTR_32(18, TMP7, (W_BASE + 2*32))
BITWISE_XOR_32(TMP6, TMP6, TMP7)
SHR_32(3, TMP7, (W_BASE + 2*32))
BITWISE_XOR_32(TMP6, TMP6, TMP7)
ADD_32(TMP4, TMP4, (W_BASE + 10*32))

ROTR_32(17, TMP4, (W_BASE + 16*32))
ROTR_32(19, TMP5, (W_BASE + 16*32))
BITWISE_XOR_32(TMP4, TMP4, TMP5)
SHR_32(10, TMP5, (W_BASE + 16*32))
BITWISE_XOR_32(TMP4, TMP4, TMP5)
ROTR_32(7, TMP6, (W_BASE + 3*32))
ROTR_32(18, TMP7, (W_BASE + 3*32))
BITWISE_XOR_32(TMP6, TMP6, TMP7)
SHR_32(3, TMP7, (W_BASE + 3*32))
BITWISE_XOR_32(TMP6, TMP6, TMP7)
ADD_32(TMP4, TMP4, (W_BASE + 11*32))

ROTR_32(17, TMP4, (W_BASE + 17*32))
ROTR_32(19, TMP5, (W_BASE + 17*32))
BITWISE_XOR_32(TMP4, TMP4, TMP5)
SHR_32(10, TMP5, (W_BASE + 17*32))
BITWISE_XOR_32(TMP4, TMP4, TMP5)
ROTR_32(7, TMP6, (W_BASE + 4*32))
ROTR_32(18, TMP7, (W_BASE + 4*32))
BITWISE_XOR_32(TMP6, TMP6, TMP7)
SHR_32(3, TMP7, (W_BASE + 4*32))
BITWISE_XOR_32(TMP6, TMP6, TMP7)
ADD_32(TMP4, TMP4, (W_BASE + 12*32))

HALT
