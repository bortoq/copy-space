# fix_bitwise.f0 — 32-bit bitwise operations via 1-bit primitives
#
# Provides macros for 32-bit operations using the VM's 1-bit ALU
# (BA, BB, BC, BR, T0, T1 registers) and 24-bit adder (VAR_A24/VAR_B24).
#
# Macros:
#   BITWISE_XOR_32(dst, src1, src2)  — 32-bit XOR
#   BITWISE_AND_32(dst, src1, src2)  — 32-bit AND
#   BITWISE_OR_32(dst, src1, src2)   — 32-bit OR
#   BITWISE_NOT_32(dst, src)         — 32-bit NOT
#   ROTR_32(n, dst, src)             — right rotate by n (n must be literal)
#   SHR_32(n, dst, src)              — right shift by n (n must be literal)
#   ADD_32(dst, src1, src2)          — 32-bit addition via 24+8 carry chain
#   WORD_SWAP_32(dst, src)           — byte swap 0<->3, 1<->2
#
# Dependencies: none (uses only VM built-in registers and directives)
#
# Scratch memory: defines SCRATCH/TMP_CARRY defaults relative to TESTG.
# Override these constants before include if default collides.

const SCRATCH (TESTG + 1024)
const TMP_CARRY SCRATCH
const SCR_BYTE (SCRATCH + 8)

macro BITWISE_XOR_32(dst, src1, src2)
  for i 0 32
    copybits 1 BA (src1 + i)
    copybits 1 BB (src2 + i)
    BXOR
    copybits 1 (dst + i) BR
  endfor
endmacro

macro BITWISE_AND_32(dst, src1, src2)
  for i 0 32
    copybits 1 BA (src1 + i)
    copybits 1 BB (src2 + i)
    BAND
    copybits 1 (dst + i) BR
  endfor
endmacro

macro BITWISE_OR_32(dst, src1, src2)
  for i 0 32
    copybits 1 BA (src1 + i)
    copybits 1 BB (src2 + i)
    BOR
    copybits 1 (dst + i) BR
  endfor
endmacro

macro BITWISE_NOT_32(dst, src)
  for i 0 32
    copybits 1 BA (src + i)
    BNOT
    copybits 1 (dst + i) BR
  endfor
endmacro

macro ROTR_32(n, dst, src)
  copybits n dst (src + (32 - n))
  copybits (32 - n) (dst + n) src
endmacro

macro SHR_32(n, dst, src)
  copybits (32 - n) (dst + n) src
  for i 0 n
    setbit (dst + i) 0
  endfor
endmacro

macro ADD_32(dst, src1, src2)
  copybits 24 VAR_A24 src1
  copybits 24 VAR_B24 src2
  ADD24
  copybits 24 dst VAR_SUM24
  copybits 1 TMP_CARRY VAR_COUT

  set24 VAR_A24 0x000000
  copybits 8 VAR_A24 (src1 + 24)
  set24 VAR_B24 0x000000
  copybits 8 VAR_B24 (src2 + 24)
  copybits 1 (VAR_B24 + 0) TMP_CARRY
  ADD24
  copybits 8 (dst + 24) VAR_SUM24
endmacro

macro WORD_SWAP_32(dst, src)
  copybits 8 SCR_BYTE (src + 0)
  copybits 8 (dst + 0) (src + 24)
  copybits 8 (dst + 24) SCR_BYTE

  copybits 8 SCR_BYTE (src + 8)
  copybits 8 (dst + 8) (src + 16)
  copybits 8 (dst + 16) SCR_BYTE
endmacro
