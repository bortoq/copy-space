# Write two bytes into TESTG, then HALT.
# Expected at TESTG: 80 aa
#
# Validates:
# - macro expansion
# - for/endfor compile-time loop
# - using loop var in expressions

macro msetbyte(dst, v)
  setbyte dst v
endmacro

# i=0 => 0x80
# i=1 => 0x80 + 0x2A = 0xAA
for i 0 1
  msetbyte((TESTG + i*8), (0x80 + i*0x2A))
endfor

HALT
