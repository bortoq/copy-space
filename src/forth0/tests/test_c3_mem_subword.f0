# C3 S7 subword memory semantics scaffold
# stop reason=1, pc=0x00000020, instr=lhu surrogate 0x00005003, steps=6
# payload bytes:
#   lb  = 0xFFFFFF80
#   lbu = 0x00000080
#   lh  = 0xFFFFFF34
#   lhu = 0x0000FF34

setbyte TESTG 0x01
setbyte (TESTG + 1*8) 0x00
setbyte (TESTG + 2*8) 0x00
setbyte (TESTG + 3*8) 0x00
setbyte (TESTG + 4*8) 0x20

setbyte (TESTG + 5*8) 0x00
setbyte (TESTG + 6*8) 0x00
setbyte (TESTG + 7*8) 0x50
setbyte (TESTG + 8*8) 0x03

setbyte (TESTG + 9*8)  0x00
setbyte (TESTG + 10*8) 0x00
setbyte (TESTG + 11*8) 0x00
setbyte (TESTG + 12*8) 0x00

setbyte (TESTG + 13*8) 0x00
setbyte (TESTG + 14*8) 0x00
setbyte (TESTG + 15*8) 0x00
setbyte (TESTG + 16*8) 0x06

setbyte (TESTG + 17*8) 0x00
setbyte (TESTG + 18*8) 0x00
setbyte (TESTG + 19*8) 0x00

# lb
setbyte (TESTG + 20*8) 0xFF
setbyte (TESTG + 21*8) 0xFF
setbyte (TESTG + 22*8) 0xFF
setbyte (TESTG + 23*8) 0x80

# lbu
setbyte (TESTG + 24*8) 0x00
setbyte (TESTG + 25*8) 0x00
setbyte (TESTG + 26*8) 0x00
setbyte (TESTG + 27*8) 0x80

# lh
setbyte (TESTG + 28*8) 0xFF
setbyte (TESTG + 29*8) 0xFF
setbyte (TESTG + 30*8) 0xFF
setbyte (TESTG + 31*8) 0x34

# lhu
setbyte (TESTG + 32*8) 0x00
setbyte (TESTG + 33*8) 0x00
setbyte (TESTG + 34*8) 0xFF
setbyte (TESTG + 35*8) 0x34

HALT
