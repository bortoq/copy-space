# C3 M0 stop/exception contract smoke test
#
# Encodes a synthetic STOP_PAGE outcome into TESTG and halts.
# Layout (bytes, big-endian words where applicable):
#   0: reason (u8)
#   1..4: guest_pc (u32)
#   5..8: instr (u32)
#   9..12: fault_addr (u32)
#   13..16: guest_steps (u32)
#   17..19: reserved (0)
#
# reason=0x03 (illegal instruction)
# guest_pc=0x00000020
# instr=0xFFFFFFFF
# fault_addr=0x00000100
# guest_steps=0x0000000A

setbyte (TESTG + 0*8) 0x03

setbyte (TESTG + 1*8) 0x00
setbyte (TESTG + 2*8) 0x00
setbyte (TESTG + 3*8) 0x00
setbyte (TESTG + 4*8) 0x20

setbyte (TESTG + 5*8) 0xFF
setbyte (TESTG + 6*8) 0xFF
setbyte (TESTG + 7*8) 0xFF
setbyte (TESTG + 8*8) 0xFF

setbyte (TESTG + 9*8) 0x00
setbyte (TESTG + 10*8) 0x00
setbyte (TESTG + 11*8) 0x01
setbyte (TESTG + 12*8) 0x00

setbyte (TESTG + 13*8) 0x00
setbyte (TESTG + 14*8) 0x00
setbyte (TESTG + 15*8) 0x00
setbyte (TESTG + 16*8) 0x0A

setbyte (TESTG + 17*8) 0x00
setbyte (TESTG + 18*8) 0x00
setbyte (TESTG + 19*8) 0x00

HALT
