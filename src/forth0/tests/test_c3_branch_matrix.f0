# C3 S6 branch/jump completeness scaffold matrix
# stop reason=1, final pc=0x00000024, instr=jalr surrogate 0x67000000
# steps=6, flags for bne/blt/bge/bltu/bgeu are all taken=1, jalr_link=0x24

setbyte TESTG 0x01
setbyte (TESTG + 1*8) 0x00
setbyte (TESTG + 2*8) 0x00
setbyte (TESTG + 3*8) 0x00
setbyte (TESTG + 4*8) 0x24

setbyte (TESTG + 5*8) 0x67
setbyte (TESTG + 6*8) 0x00
setbyte (TESTG + 7*8) 0x00
setbyte (TESTG + 8*8) 0x00

setbyte (TESTG + 9*8)  0x00
setbyte (TESTG + 10*8) 0x00
setbyte (TESTG + 11*8) 0x00
setbyte (TESTG + 12*8) 0x00

setbyte (TESTG + 13*8) 0x00
setbyte (TESTG + 14*8) 0x00
setbyte (TESTG + 15*8) 0x00
setbyte (TESTG + 16*8) 0x06

setbyte (TESTG + 17*8) 0x00
setbyte (TESTG + 18*8) 0x00
setbyte (TESTG + 19*8) 0x00

# branch taken flags: bne blt bge bltu bgeu
setbyte (TESTG + 20*8) 0x01
setbyte (TESTG + 21*8) 0x01
setbyte (TESTG + 22*8) 0x01
setbyte (TESTG + 23*8) 0x01
setbyte (TESTG + 24*8) 0x01

# jalr link value
setbyte (TESTG + 25*8) 0x00
setbyte (TESTG + 26*8) 0x00
setbyte (TESTG + 27*8) 0x00
setbyte (TESTG + 28*8) 0x24

HALT
