# test_compile_one.f0 — smoke test for COMPILE_ONE word
#
# Places a token (HALT) in a known location, then calls COMPILE_ONE
# to read it and build a cell. Verifies the cell was created.

# === Step 1: Write a token value into TESTG ===
# Store the HALT word address as a token at TESTG + 200 bits
set24 (TESTG + 200) HALT

# === Step 2: Set up compile state ===
# VAR_PREV_NEXT_FLD = HEAD_CELL + 32 (point to head cell's next_ptr)
set24 VAR_PREV_NEXT_FLD (HEAD_CELL + 32)

# VAR_N = address where token is stored (= TESTG + 200)
# IMPORTANT: must come AFTER all set24 directives, which use LITN internally
# and would clobber VAR_N.
LITN (TESTG + 200)

# === Step 3: Call COMPILE_ONE ===
COMPILE_ONE

# === Step 4: Copy VAR_CUR (address of new cell) to output area ===
copybits 24 (TESTG + 384) VAR_CUR

# === Step 5: Trigger HALT (VM will be inspected directly via dump) ===
HALT
