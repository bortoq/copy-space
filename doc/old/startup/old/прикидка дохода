/* copy value, move way down */
else
{
  vm1->subspace[i].value = vm1->subspace[vm1->subspace[i].link[l]].value;
  vm1->subspace[vm1->subspace[i].link[l]].way = 0;
  vm1->subspace[i].way = 1;
}
}
}

